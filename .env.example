# 复制为 .env 后按需修改：cp .env.example .env
# 不要修改本文件中的占位值，真实密钥只放在 .env 里。

# 【必填】JWT 签名密钥，至少 32 字符。
# 生成方式：openssl rand -base64 48
# 未设置或短于 32 字符时，后端会拒绝启动。
JWT_SECRET=

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mall_db
# 宿主机映射端口（容器内始终是 3306）
MYSQL_PORT=3307

REDIS_PORT=6379

BACKEND_PORT=8080
FRONTEND_PORT=3000

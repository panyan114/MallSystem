<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.5</version>
        <relativePath/>
    </parent>

    <groupId>com.mall</groupId>
    <artifactId>mall-system</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>mall-system</name>
    <description>个人店铺电商系统</description>

    <properties>
        <java.version>17</java.version>
        <!--
            覆盖 spring-boot-starter-parent 管理的版本，保证 testcontainers 各模块版本一致。
            不能用更老的 1.19.x：它绑的 docker-java 默认发 API 1.32，而 Docker Engine 25+
            最低只支持 1.40，握手会被回 400 BadRequest，表现为「找不到 Docker 环境」并静默跳过全部集成测试。
        -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <!--
            见下方 surefire 配置。Docker Engine 29 起最低只支持 API 1.40，
            而 Testcontainers 在未指定版本时会硬编码 1.32，握手被回 400。
            1.41 是能同时被 Docker 20.10 和 29 接受的安全值；
            如果将来又出现握手失败，用 -Ddocker.api.version=1.44 覆盖即可。
        -->
        <docker.api.version>1.41</docker.api.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>1.2.83</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            集成测试跑在真实 MySQL 8.0 + Redis 上（与 docker-compose 同镜像）。
            OrderServiceImpl 的核心保证——条件扣减防超卖、状态流转的原子性——
            都依赖 InnoDB 的行锁与 UPDATE ... WHERE 语义，用 Mockito 打桩会把
            真正要验证的东西整个绕过去，所以这里坚持用真实数据库。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>mall-system</finalName>
        <!--
            把 docker/mysql/init/init.sql 挂到测试 classpath 上，供 Testcontainers
            的 withInitScript 使用。刻意不复制一份到 src/test/resources——历史上本
            项目正是因为维护了两份分叉的建库脚本（缺 deleted 列、种子密码 hash 非
            法）才导致店主无法登录。让测试直接消费生产同一份脚本，等于把「脚本能
            否建出实体类预期的表结构」变成一条每次 mvn test 都会跑的断言。
        -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../docker/mysql/init</directory>
                <includes>
                    <include>init.sql</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <!--
                把 docker-java 的 API 版本显式告诉 Testcontainers。

                Testcontainers 的 DockerClientProviderStrategy 里有这么一段：
                    if (configBuilder.build().getApiVersion() == UNKNOWN_VERSION) {
                        configBuilder.withApiVersion(RemoteApiVersion.VERSION_1_32);
                    }
                也就是「没配就当作 1.32」。而 Docker Engine 29 的最低支持版本已经是 1.40，
                于是每一次 /v1.32/info 都被回 400 BadRequest，Testcontainers 判定
                「找不到 Docker 环境」，而 disabledWithoutDocker=true 又让全部集成测试
                静默跳过——构建照样是 BUILD SUCCESS，只是什么都没验证。

                docker-java 的 DefaultDockerClientConfig 会从 JVM 系统属性读取 api.version，
                所以这里在 surefire 里注入，不改动任何被测代码，也不需要用户配环境变量。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
